<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Nexus Agent — Always-On Daemon -->
    <!-- Install: cp com.nexus.agent.plist ~/Library/LaunchAgents/ -->
    <!-- Load:    launchctl load ~/Library/LaunchAgents/com.nexus.agent.plist -->
    <!-- Unload:  launchctl unload ~/Library/LaunchAgents/com.nexus.agent.plist -->
    <!-- Status:  launchctl list | grep nexus -->
    <!--
         Boot order: Ollama (homebrew.mxcl.ollama) starts first via its own plist.
         Nexus waits 10s (StartInterval) for Ollama to be ready, then connects.
         OllamaClient.is_available() auto-detects backend (Ollama or llama-server).
    -->

    <key>Label</key>
    <string>com.nexus.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/lennyfinn/Nexus/venv/bin/python</string>
        <string>-m</string>
        <string>uvicorn</string>
        <string>main:app</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--port</string>
        <string>8080</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/lennyfinn/Nexus/backend</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/lennyfinn/Nexus/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>VIRTUAL_ENV</key>
        <string>/Users/lennyfinn/Nexus/venv</string>
        <key>PYTHONPATH</key>
        <string>/Users/lennyfinn/Nexus/backend</string>
    </dict>

    <!-- Start on login / system boot -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart automatically on crash (10 second throttle — gives Ollama time to load) -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- Logging -->
    <key>StandardOutPath</key>
    <string>/Users/lennyfinn/Nexus/backend/logs/launchd-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/lennyfinn/Nexus/backend/logs/launchd-stderr.log</string>

    <!-- Resource limits -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
    <key>HardResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>8192</integer>
    </dict>

    <!-- Nice level (0 = normal) -->
    <key>Nice</key>
    <integer>0</integer>
</dict>
</plist>
